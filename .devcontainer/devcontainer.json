{
  "dockerComposeFile": "docker-compose.yaml",
  "service": "research-dev",
  "runServices": [
    "research-dev",
    "qdrant",
    "falkordb",
    "graphiti"
  ],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "updateRemoteUserUID": false,
  "postCreateCommand": "just init",
  "remoteEnv": {
    "OPENCODE_CONFIG_DIR": "${containerEnv:OPENCODE_CONFIG_DIR}",
    "PATH": "${containerEnv:UV_TOOL_BIN_DIR}:${containerEnv:JS_TOOL_BIN_DIR}:/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "jeff-hykin.better-dockerfile-syntax",
        "tomoki1207.pdf",
        "james-yu.latex-workshop",
        "tamasfe.even-better-toml",
        "nefrob.vscode-just-syntax",
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "julialang.language-julia",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow",
        "ms-toolsai.vscode-jupyter-powertoys"
      ]
    }
  }
}
