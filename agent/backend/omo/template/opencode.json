{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "agent/agent.md",
    "agent/workflow/role/architect.md",
    "agent/workflow/role/manager.md",
    "agent/workflow/role/reviewer.md",
    "agent/workflow/role/worker.md",
    "agent/workflow/role/control.md",
    "agent/workflow/session/architect.md",
    "agent/workflow/session/manager.md",
    "agent/workflow/session/reviewer.md",
    "agent/workflow/session/worker.md",
    "agent/workflow/lifecycle.md",
    "agent/workflow/artifact.md",
    "agent/workflow/command.md"
  ],
  "plugin": ["oh-my-openagent"],
  "share": "manual",
  "autoupdate": "notify",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "git reset --hard*": "deny",
      "git push --force*": "deny"
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".venv/**",
      ".ruff_cache/**",
      "build/**",
      "out/**",
      "__pycache__/**"
    ]
  }
}
