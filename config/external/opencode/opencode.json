{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent"
  ],
  "share": "manual",
  "autoupdate": "notify",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "git reset --hard*": "deny",
      "git push --force*": "deny"
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "out/**"
    ]
  },
  "lsp": {
    "biome": {
      "command": [
        "bunx",
        "@biomejs/biome",
        "lsp-proxy"
      ],
      "extensions": [
        ".astro",
        ".css",
        ".graphql",
        ".gql",
        ".html",
        ".js",
        ".json",
        ".jsonc",
        ".jsx",
        ".mjs",
        ".svelte",
        ".ts",
        ".tsx",
        ".vue"
      ]
    },
    "pyright": {
      "command": [
        "uvx",
        "--from",
        "pyright",
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "yaml-ls": {
      "command": [
        "bunx",
        "yaml-language-server",
        "--stdio"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "set -a; . /workspace/config/external/playwright-mcp/.env; set +a; exec bunx @playwright/mcp@0.0.73"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "qdrant": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "set -a; . /workspace/config/external/mcp-server-qdrant/.env; set +a; exec uvx mcp-server-qdrant"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "graphiti": {
      "type": "remote",
      "url": "http://graphiti:8000/mcp/",
      "enabled": true
    }
  }
}
